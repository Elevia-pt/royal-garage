# Royal Garage — env vars para o backend PHP no Hostinger.
# Copia este ficheiro para .env na raiz do site (public_html/<dominio>/.env)
# e preenche com os valores reais. O .htaccess bloqueia acesso direto via web.

# Supabase (autenticação do admin)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....

# GitHub (PAT fine-grained, Contents: Read and write em Elevia-pt/royal-garage)
GITHUB_TOKEN=github_pat_...
GITHUB_OWNER=Elevia-pt
GITHUB_REPO=royal-garage
GITHUB_BRANCH=main

# Cloudinary (uploads de fotos via signed URL)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
