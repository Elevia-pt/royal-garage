# Royal Garage — env vars para o backend PHP no Hostinger.
# Copia este ficheiro para .env na raiz do site (public_html/<dominio>/.env)
# e preenche com os valores reais. O .htaccess bloqueia acesso direto via web.

# Login do painel admin (feito neste servidor, sem servicos externos).
#
# AUTH_SECRET: string aleatoria e longa, usada para assinar os tokens de
# sessao. Se a mudares, toda a gente tem de voltar a fazer login.
AUTH_SECRET=

# ADMIN_USERS: contas que podem entrar no /admin, separadas por virgulas,
# no formato  email:hash  (o hash e' PBKDF2-SHA256, nunca a password em
# claro). Tirar uma conta daqui corta-lhe o acesso de imediato, mesmo que
# tenha sessao aberta.
ADMIN_USERS=alguem@exemplo.pt:pbkdf2_sha256$310000$<salt_hex>$<hash_hex>

# GitHub (PAT fine-grained, Contents: Read and write em Elevia-pt/royal-garage)
GITHUB_TOKEN=github_pat_...
GITHUB_OWNER=Elevia-pt
GITHUB_REPO=royal-garage
GITHUB_BRANCH=main

# Cloudinary (uploads de fotos via signed URL)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
