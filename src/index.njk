---
layout: base.njk
permalink: /
---
{% set featured = cars | selectattr("featured") | first %}
{% if not featured %}{% set featured = cars[0] %}{% endif %}

<main id="top">
  {% set waCarMsg = "Olá " + site.name + ", tenho interesse no " + featured.marca + " " + featured.modelo + ". Ainda está disponível?" %}
  <section class="hero-featured">
    <div class="wrap">
      <span class="kick">{{ site.tagline }}</span>
      <article class="featured-card">
        <div class="featured-card-media">
          <img src="/assets/cars/{{ featured.photos[0] }}" alt="{{ featured.marca }} {{ featured.modelo }}">
          <span class="destaque-badge">Em destaque</span>
        </div>
        <div class="featured-card-info">
          <h1 class="disp brand">{{ featured.marca }}</h1>
          <p class="model">{{ featured.modelo }}</p>
          <ul class="featured-specs">
            <li>{{ featured.ano }}</li>
            <li>{{ featured.km | km }}</li>
            <li>{{ featured.comb }}</li>
            {% if featured.cv %}<li>{{ featured.cv }} cv</li>{% endif %}
          </ul>
          <div class="featured-divider"></div>
          <div class="featured-price">{{ featured.preco | price }}</div>
          <div class="featured-cta">
            <a class="btn btn-gold" href="/viatura/{{ featured.slug }}/" style="color:#000">Ver detalhes <span class="arr">→</span></a>
            <a class="btn btn-out" href="{{ waCarMsg | waLink(site.whatsapp) }}" target="_blank" rel="noopener">WhatsApp</a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <div class="stats">
    <div class="wrap stats-grid">
      <div class="stat"><div class="num gold" data-count="{% yearsSince site.yearStarted %}">0</div><div class="lbl">Anos no mercado</div></div>
      <div class="stat"><div class="num gold" data-count="{{ cars | length }}">0</div><div class="lbl">Viaturas em stock</div></div>
      <div class="stat"><div class="num gold" data-count="100" data-suffix="%">0</div><div class="lbl">Inspecionadas</div></div>
    </div>
  </div>

  <section id="viaturas">
    <div class="wrap">
      <div class="head reveal">
        <div><span class="kick">O nosso stock</span><h2 class="disp">Viaturas disponíveis</h2></div>
        <button class="btn btn-out" id="filter-toggle" type="button">Filtrar <span class="arr">▾</span></button>
      </div>

      <div class="filters-panel reveal" id="filters" hidden>
        <div class="filter-grid">
          <div class="filter-field">
            <label for="f-marca">Marca</label>
            <select id="f-marca">
              <option value="">Todas</option>
              {% for marca in brands %}<option>{{ marca }}</option>{% endfor %}
            </select>
          </div>
          <div class="filter-field">
            <label for="f-comb">Combustível</label>
            <select id="f-comb">
              <option value="">Todos</option>
              <option>Diesel</option>
              <option>Gasolina</option>
              <option>Híbrido</option>
              <option>Híbrido Plug-in</option>
              <option>Elétrico</option>
              <option>GPL</option>
            </select>
          </div>
          <div class="filter-field">
            <label for="f-caixa">Caixa</label>
            <select id="f-caixa">
              <option value="">Todas</option>
              <option>Manual</option>
              <option>Automática</option>
            </select>
          </div>
          <div class="filter-field">
            <label for="f-carroceria">Carroçaria</label>
            <select id="f-carroceria">
              <option value="">Todas</option>
              <option>Hatchback</option>
              <option>Sedan</option>
              <option>Carrinha</option>
              <option>SUV</option>
              <option>Monovolume</option>
              <option>Coupé</option>
              <option>Descapotável</option>
            </select>
          </div>
          <div class="filter-field">
            <label>Preço (€)</label>
            <div class="filter-range">
              <input type="number" id="f-preco-min" placeholder="Mín" inputmode="numeric">
              <input type="number" id="f-preco-max" placeholder="Máx" inputmode="numeric">
            </div>
          </div>
          <div class="filter-field">
            <label>Ano</label>
            <div class="filter-range">
              <input type="number" id="f-ano-min" placeholder="De" inputmode="numeric">
              <input type="number" id="f-ano-max" placeholder="Até" inputmode="numeric">
            </div>
          </div>
          <div class="filter-field">
            <label for="f-km-max">Km (até)</label>
            <input type="number" id="f-km-max" placeholder="Ex: 150000" inputmode="numeric">
          </div>
          <div class="filter-field">
            <label for="f-sort">Ordenar por</label>
            <select id="f-sort">
              <option value="recent">Mais recentes</option>
              <option value="price-asc">Preço ↑</option>
              <option value="price-desc">Preço ↓</option>
              <option value="km-asc">Menos km</option>
            </select>
          </div>
        </div>
        <div class="filter-actions">
          <span id="filter-count" class="filter-count">{{ cars | length }} viaturas</span>
          <button class="btn btn-out btn-small" id="filter-clear" type="button">Limpar filtros</button>
        </div>
      </div>

      <div class="grid" id="grid">
        {% for c in cars %}
          {% include "partials/car-card.njk" %}
        {% endfor %}
      </div>

      <div class="empty-state" id="empty-state" hidden>
        <p>Nenhuma viatura encontrada com estes filtros.</p>
      </div>
    </div>
  </section>

  <section id="porque" class="why">
    <div class="wrap">
      <div class="head reveal" style="justify-content:center;text-align:center;flex-direction:column">
        <span class="kick">Porquê o {{ site.name }}</span>
        <h2 class="disp">Comprar com confiança</h2>
      </div>
      <div class="why-grid">
        <div class="feat reveal"><div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/></svg></div><h4>Viaturas inspecionadas</h4><p>Cada carro verificado e preparado antes de chegar a si.</p></div>
        <div class="feat reveal"><div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="3"/></svg></div><h4>Financiamento</h4><p>Soluções à medida tratadas no próprio stand.</p></div>
        <div class="feat reveal"><div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z"/></svg></div><h4>Garantia incluída</h4><p>Conduza tranquilo com garantia em cada negócio.</p></div>
        <div class="feat reveal"><div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 4v5h-5"/></svg></div><h4>Retoma do usado</h4><p>Damos o melhor valor pelo seu carro atual.</p></div>
      </div>
    </div>
  </section>

  <section id="localizacao">
    <div class="wrap">
      <div class="head reveal" style="flex-direction:column;align-items:flex-start"><span class="kick">Onde estamos</span><h2 class="disp">Passa pelo stand</h2></div>
      <div class="loc-grid">
        <div class="loc-info reveal">
          <div class="loc-row"><div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></div><div><h4>Morada</h4><p>{{ site.address.street }}, {{ site.address.area }} ({{ site.address.municipality }})</p></div></div>
          <div class="loc-row"><div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></div><div><h4>Horário</h4><p>{{ site.hours.weekdays }}<br>{{ site.hours.saturday }}</p></div></div>
          <div class="loc-row"><div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.4-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg></div><div><h4>Telefone</h4><p>{{ site.phone }}</p></div></div>
          <div class="cta" style="display:flex;gap:12px;flex-wrap:wrap">
            <a class="btn btn-gold" href="https://www.google.com/maps/dir/?api=1&destination={{ site.address.googleMapsQuery | urlencode }}" target="_blank" rel="noopener" style="color:#000">Ver direções <span class="arr">→</span></a>
            <a class="btn btn-out" href="tel:{{ site.phoneIntl }}">Ligar</a>
          </div>
        </div>
        <div class="map reveal"><iframe loading="lazy" src="https://www.google.com/maps?q={{ site.address.googleMapsQuery | urlencode }}&output=embed" title="Mapa {{ site.name }}"></iframe></div>
      </div>
    </div>
  </section>

  <section id="contacto" class="cta-band">
    <div class="wrap reveal">
      <span class="kick">Vamos a isto</span>
      <h2 class="disp gold" style="margin-top:8px">Liga e marca a tua visita</h2>
      <a class="phone gold" href="tel:{{ site.phoneIntl }}">{{ site.phone }}</a>
      <div class="cta">
        <a class="btn btn-gold" href="tel:{{ site.phoneIntl }}" style="color:#000">Ligar agora</a>
        <a class="btn btn-out" href="{{ site.whatsappDefaultMsg | waLink(site.whatsapp) }}" target="_blank" rel="noopener">Enviar WhatsApp</a>
      </div>
    </div>
  </section>
</main>
